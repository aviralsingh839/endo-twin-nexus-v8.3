# ENDO-TWIN / CHRONO-PCOS V8.3+ - Environment Variables Example
# Copy to .env and fill in actual values - DO NOT commit .env with secrets
# This file is safe to commit - contains no real secrets

# LLM Assistant (optional, for research assistance, not required for core functionality)
# Provider: openai, anthropic, local, etc.
CHRONO_LLM_PROVIDER=
CHRONO_LLM_URL=
CHRONO_LLM_MODEL=
CHRONO_LLM_API_KEY=

# Database (optional, defaults to local SQLite)
# For local-first offline-first, default is SQLite - no cloud needed
# Example: DATABASE_URL=sqlite:///data/endo_twin.db
DATABASE_URL=sqlite:///data/endo_twin.db

# Security (optional)
# Encryption key path - generated if not exists, using Fernet if available
ENCRYPTION_KEY_PATH=data/keys/fernet.key

# Android (optional, for builds)
# Set these for real Gradle builds ./gradlew assembleDebug
# ANDROID_SDK_ROOT is standard, ANDROID_HOME legacy
ANDROID_SDK_ROOT=
ANDROID_HOME=
# Example: ANDROID_SDK_ROOT=$HOME/Android/Sdk

# Java (optional, for builds)
# JAVA_HOME should point to JDK 17+
# Example: JAVA_HOME=/usr/lib/jvm/java-17-openjdk
JAVA_HOME=

# Provider Directory (optional, for care discovery)
# OSM - no API key needed offline-first
# If using online maps, no API key required for OSM
# For optional online features:
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Website (optional, public website separate from patient systems)
# No private patient data in public website
WEBSITE_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Demo mode
DEMO_MODE=false

# Safety: Research / risk-screening output — not a medical diagnosis
# No private patient data in public website
# No upload private health to public website, default no cloud
# Local-first, offline-first, privacy-focused
