[Desktop Entry]
Name=CHRONO-PCOS V8.3+ Control Center
Comment=Sense • Model • Predict • Personalize • Connect - Research risk-screening not diagnosis
Exec=bash -c 'SCRIPT_DIR="$(cd -- "$(dirname -- "%k")" && pwd)"; PROJECT_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"; if [ "$(basename "$SCRIPT_DIR")" = "desktop" ]; then PROJECT_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"; fi; bash "$PROJECT_ROOT/COMPLETE_LAUNCHER.sh"'
Icon=applications-science
Terminal=false
Type=Application
Categories=Science;MedicalSoftware;Education;
Path=
StartupNotify=true
